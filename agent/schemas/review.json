{
  "type": "object",
  "additionalProperties": false,
  "required": ["result", "efficiency_read", "calibration", "prior_proposals"],
  "properties": {
    "result": {"type": "string", "description": "Won or lost, by how much."},
    "efficiency_read": {
      "type": "string",
      "description": "What manager efficiency says about the AGENT, separate from luck."
    },
    "calibration": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Directional misses only. Magnitude of one week is noise."
    },
    "league_scan": {"type": "array", "items": {"type": "string"}},
    "prior_proposals": {
      "type": "array",
      "description": "Proposed changes to priors.yaml. Usually empty (§7.3).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "from", "to", "evidence"],
        "properties": {
          "key": {"type": "string", "description": "Dotted priors.yaml key."},
          "from": {"type": ["number", "string"]},
          "to": {"type": ["number", "string"]},
          "evidence": {"type": "string", "description": "The repeated, directional pattern."}
        }
      }
    },
    "watch_items": {"type": "array", "items": {"type": "string"}}
  }
}
