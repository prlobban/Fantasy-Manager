{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "espn_id", "name", "status", "usage", "matchup", "analyst_read",
    "news_since", "week_multiplier", "ros_multiplier", "veto", "confidence", "sources"
  ],
  "properties": {
    "espn_id": {"type": "integer"},
    "name": {"type": "string"},
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designation", "practice", "detail"],
      "properties": {
        "designation": {
          "type": "string",
          "enum": ["healthy", "questionable", "doubtful", "out", "ir", "suspended", "unknown"]
        },
        "practice": {
          "type": "string",
          "enum": ["full", "limited", "dnp", "not_reported", "unknown"],
          "description": "The most recent practice participation you found."
        },
        "detail": {"type": "string", "maxLength": 400}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trend", "detail"],
      "properties": {
        "trend": {"type": "string", "enum": ["rising", "stable", "falling", "unknown"]},
        "snap_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "target_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "detail": {"type": "string", "maxLength": 400,
                   "description": "Snaps, targets, carries, routes, red-zone use — last 1-3 games vs season. Numbers where they exist."}
      }
    },
    "matchup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "detail"],
      "properties": {
        "read": {"type": "string", "enum": ["good", "neutral", "bad", "unknown"]},
        "vegas_total": {"type": ["number", "null"]},
        "spread": {"type": ["number", "null"], "description": "His team's spread; negative = favoured."},
        "detail": {"type": "string", "maxLength": 400,
                   "description": "Opponent vs his position recently, game script, pace, weather if outdoors and late-season."}
      }
    },
    "analyst_read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consensus", "detail"],
      "properties": {
        "consensus": {"type": "string", "enum": ["start", "flex", "sit", "split", "unknown"]},
        "detail": {"type": "string", "maxLength": 400,
                   "description": "What named analysts/outlets say this week, and whether they agree."}
      }
    },
    "news_since": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "headline", "url"],
        "properties": {
          "date": {"type": "string", "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"},
          "headline": {"type": "string", "maxLength": 300},
          "url": {"type": "string", "format": "uri"}
        }
      }
    },
    "week_multiplier": {
      "type": "number", "minimum": 0.75, "maximum": 1.25,
      "description": "Applied to ESPN's THIS-WEEK projection. 1.0 unless usage/status/matchup evidence earns a move. Clamped in code."
    },
    "ros_multiplier": {
      "type": "number", "minimum": 0.85, "maximum": 1.15,
      "description": "Applied to the rest-of-season projection. Role changes only. Clamped in code."
    },
    "veto": {"type": "boolean", "description": "Should not be started or rostered: out for the season, suspended, released."},
    "veto_reason": {"type": ["string", "null"], "maxLength": 300},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {"type": "string", "format": "uri"}
    }
  }
}
