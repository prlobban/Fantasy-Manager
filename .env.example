# Copy to .env and fill in. .env is gitignored — never commit it, never paste
# these values into a chat, a doc, or the vault.

# ── ESPN ─────────────────────────────────────────────────────────────────────
# Chrome, logged into ESPN → DevTools → Application → Cookies → https://www.espn.com
# SWID includes the curly braces. espn_s2 is very long and URL-encoded.
ESPN_SWID={00000000-0000-0000-0000-000000000000}
ESPN_S2=
ESPN_LEAGUE_ID=
ESPN_SEASON=2026
# Our team, by name. core resolves it to a team id on first read.
ESPN_TEAM_NAME=big P

# ── Notifications ────────────────────────────────────────────────────────────
# Slack #fantasy in the Lane One workspace. The box posts as Polaris.
SLACK_TOKEN_FILE=/home/ironman/.slack-laneone/token.json
SLACK_CHANNEL_ID=C0BUTMBSZ0W

# ── Runtime ──────────────────────────────────────────────────────────────────
# Master write switch. Anything other than "on" refuses every write (§8.4).
ENABLED_FILE=./ENABLED
DATA_DIR=./data
LOG_LEVEL=INFO

# Draft day. Used only for staleness checks on the board.
DRAFT_AT=2026-09-05T11:00:00-05:00

# ── Agent ────────────────────────────────────────────────────────────────────
CLAUDE_BIN=/home/ironman/.npm-global/bin/claude
CLAUDE_MODEL=claude-opus-5
AGENT_MAX_TURNS=12
